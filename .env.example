# Copia este archivo como ".env" para desarrollo local.
# En Cloudflare Pages se define en: Settings > Variables and Secrets.
#
# El sitio funciona sin ninguna variable. Esta es opcional pero recomendada.

# Dominio definitivo del sitio, sin diagonal al final.
# Se usa para las URL canónicas, Open Graph, sitemap.xml y robots.txt.
# Si se deja vacío, se toma "url" de src/data/siteConfig.js; si también está
# vacío, la compilación termina bien pero NO genera sitemap ni canonicals
# estáticos (verás un aviso en la consola).
VITE_SITE_URL=https://www.tu-dominio.com
